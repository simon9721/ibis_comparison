# Python cache
__pycache__/
*.py[cod]

# Large/generated simulator waveform outputs
*.raw
*.cir.csv
*.prn
*.out
*.log
*.err
*_out.txt
test_*.txt
rsf_compare_log*.txt

# Local reference documents
*.pdf

# Separate local clone used for optional eye-tool reference
/eye/

# Scratch workspace copies
/.tmp/
/experiments/
/results/ngspice_lab_gui_run/
/results/tmp_coeff_state_check/

# Local tool/dependency installs used by Codex runs
/.codex_deps/
/tools/presentation_kit/mathjax/node_modules/

# Download caches inside generated studies
/results/**/cache/*.zip
/results/_golden_hspice_cache/

# Archive sidecar metadata
__MACOSX/
._*

# Stress-matrix raw simulation output. The per-case waveform CSVs, figures and
# summary tables are kept; the ngspice/HSPICE raw files behind them run to 5.3 GB
# and are reproducible from the committed scripts and the IBIS/netlist inputs.
results/stress_method_matrix_*/*/ngspice_runs/
results/stress_method_matrix_*/*/hspice_fixtures/
results/stress_method_matrix_*/*/hspice_references/
results/stress_method_matrix_*/*/generated_models/
results/stress_method_matrix_*/*/plots/

# manim scratch renders; the published copy lives in results/kukd_animation/
media/

# HSPICE per-run intermediates (pure output, never source). These are the bulk
# of the untracked tree and were partly committed before this rule; see the
# separate untracking step to drop the tracked ones. Kept out going forward.
*.tr0
*.st0
*.ic0
*.pa0
*.lis
*.msg
*.spi
*.mt0
*.pa1
*.tr0.tmp

# Local scratch / tool caches
/.tmp/
/.pytest_cache/

# Per-case IBIS copies inside sweep run directories. Each case dir gets a
# shutil.copy2 of its source model so the deck can say file='input.ibs'; for the
# ex2 variants that is 0.54 MB duplicated ~50 times. The sources are tracked under
# results/*_variants_*/**/selection/, and the sweep re-copies on every run.
results/**/w*ps/*/input.ibs
