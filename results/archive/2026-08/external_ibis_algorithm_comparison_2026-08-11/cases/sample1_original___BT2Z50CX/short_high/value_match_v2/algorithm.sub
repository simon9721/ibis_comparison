B48 HVMATCHCMD 0 V = (V(VMACTIVATE) > 0.5) ? 1.0 : ((V(VMARG) < vm_end_ns) ? V(HVMATCH) : 0.0)
CHVMATCH HVMATCH 0 {sample_c} ic=0
RHVMATCH HVMATCH 0 1e15
BHVMATCH HVMATCH 0 I = -{sample_c} * (V(HVMATCHCMD) - V(HVMATCH)) / match_tau

* Keep the sampled state selected continuously from reverse-edge detect until value-match replay owns the target.
B48A HVMHOLDTARGET 0 V = (V(HREVERSE_EDGE) > 0.5) ? 1.0 : ((V(HVMATCH) > 0.05) ? 0.0 : V(HVMPENDING))
CHVMPENDING HVMPENDING 0 {sample_c} ic=0
RHVMPENDING HVMPENDING 0 1e15
B48B HVMPENDING 0 I = -{sample_c} * (V(HVMHOLDTARGET) - V(HVMPENDING)) / match_tau
B48C HPREHOLD 0 V = (V(VMSAMPLE) > 0.5 || V(VMLATCHPULSE) > 0.5 || V(VMACTIVATE) > 0.5 || V(HVMPENDING) > 0.05) ? 1.0 : 0.0
B48D KUPENDING 0 V = (V(VMSAMPLE) > 0.5) ? V(KUPRE) : V(KUSAMP)
B48E KDPENDING 0 V = (V(VMSAMPLE) > 0.5) ? V(KDPRE) : V(KDSAMP)
B49 KUTARGET 0 V = (V(HVMATCH) > 0.05) ? V(KUMATCH) : ((V(HPREHOLD) > 0.5) ? V(KUPENDING) : V(KULEG))
B50 KDTARGET 0 V = (V(HVMATCH) > 0.05) ? V(KDMATCH) : ((V(HPREHOLD) > 0.5) ? V(KDPENDING) : V(KDLEG))
B50A COEFF_JUMP_KU 0 V = 0.0
B50B COEFF_JUMP_KD 0 V = 0.0
B51 Ku 0 V = V(KUTARGET)
B52 Kd 0 V = V(KDTARGET)

.ENDS
