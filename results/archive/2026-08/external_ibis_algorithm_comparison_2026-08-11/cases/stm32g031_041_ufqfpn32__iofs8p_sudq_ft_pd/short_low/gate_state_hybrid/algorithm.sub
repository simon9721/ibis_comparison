BHIGHRESET HIGHAGE 0 I = {age_c} * V(RISEEDGE) * V(HIGHAGE) / edge_delay
CHIGHAGE HIGHAGE 0 {age_c} ic=0
RHIGHAGE HIGHAGE 0 1e15
BLOWAGE LOWAGE 0 I = -{age_c} * ((V(NENABLE) > 0.5 && V(NINX) < 0.5 && V(HAD_RISE) > 0.5) ? 1e9 : 0.0)
BLOWRESET LOWAGE 0 I = {age_c} * V(FALLEDGE) * V(LOWAGE) / edge_delay
CLOWAGE LOWAGE 0 {age_c} ic=0
RLOWAGE LOWAGE 0 1e15
CHADRISE HAD_RISE 0 {latch_c} ic=0
RHADRISE HAD_RISE 0 1e15
BHADRISE HAD_RISE 0 I = -{latch_c} * V(RISEEDGE) * (1.0 - V(HAD_RISE)) / (0.1 * edge_delay)
CHADFALL HAD_FALL 0 {latch_c} ic=0
RHADFALL HAD_FALL 0 1e15
BHADFALL HAD_FALL 0 I = -{latch_c} * V(FALLEDGE) * (1.0 - V(HAD_FALL)) / (0.1 * edge_delay)
BHFALL_AFTER_RISE HFALL_AFTER_RISE 0 V = (V(NENABLE) > 0.5 && V(NINX) < 0.5 && V(HAD_RISE) > 0.5 && V(HIGHAGE) > 0.01 && V(HIGHAGE) < retrigger_window_ns) ? 1.0 : 0.0
BHRISE_AFTER_FALL HRISE_AFTER_FALL 0 V = (V(NENABLE) > 0.5 && V(NINX) > 0.5 && V(HAD_FALL) > 0.5 && V(LOWAGE) > 0.01 && V(LOWAGE) < retrigger_window_ns) ? 1.0 : 0.0
BHREVERSERAW HREVERSERAW 0 V = (V(HFALL_AFTER_RISE) > 0.5 || V(HRISE_AFTER_FALL) > 0.5) ? 1.0 : 0.0
* Continuous settling progress is diagnostic only; no min/max threshold loop.
BHSETTLED HSETTLED 0 V = (V(NINX) > 0.5) ? 0.5*(V(GUP)+1.0-V(GDN)) : 0.5*(1.0-V(GUP)+V(GDN))
BHHYBRIDACTIVE HHYBRIDACTIVE 0 V = (V(HREVERSERAW) > 0.5 && V(HNX) < hybrid_recovery_ns) ? 1.0 : 0.0
B42 KUTARGET 0 V = V(HHYBRIDACTIVE) * V(KUGATE) + (1.0 - V(HHYBRIDACTIVE)) * V(KULEG)
B43 KDTARGET 0 V = V(HHYBRIDACTIVE) * V(KDGATE) + (1.0 - V(HHYBRIDACTIVE)) * V(KDLEG)
B44 Ku 0 V = (V(HHYBRIDACTIVE) > 0.5) ? V(KUGATE) : V(KULEG)
B45 Kd 0 V = (V(HHYBRIDACTIVE) > 0.5) ? V(KDGATE) : V(KDLEG)

.ENDS
