BV3KDREPLAY V3KDREPLAY 0 V = V(V3KDRAW) + (V(V3KDANCHOR) - V(V3KDSTARTVAL)) * (1.0 - V(V3KDPROGRESS))
BV3ENDERRKU V3ENDERRKU 0 V = abs(V(V3KUREPLAY) - V(KULEG))
BV3ENDERRKD V3ENDERRKD 0 V = abs(V(V3KDREPLAY) - V(KDLEG))
BV3DONE V3DONE 0 V = (V(V3KUPROGRESS) > 0.999 && V(V3KDPROGRESS) > 0.999 && V(V3ENDERRKU) <= v3_alignment_tol && V(V3ENDERRKD) <= v3_alignment_tol) ? 1.0 : 0.0
CV3ACTIVE HV3ACTIVE 0 {latch_c} ic=0
RV3ACTIVE HV3ACTIVE 0 1e15
BV3ACTIVECMD V3ACTIVECMD 0 V = (V(V3ACTIVATE) > 0.5) ? 1.0 : ((V(HV3ACTIVE) > 0.05 && V(V3DONE) < 0.5) ? 1.0 : 0.0)
BV3ACTIVE HV3ACTIVE 0 I = -{latch_c} * (V(V3ACTIVECMD) - V(HV3ACTIVE)) / v3_state_tau
CV3PENDING HV3PENDING 0 {latch_c} ic=0
RV3PENDING HV3PENDING 0 1e15
BV3PENDINGCMD V3PENDINGCMD 0 V = (V(V3REVEDGE) > 0.5) ? 1.0 : ((V(HV3ACTIVE) > 0.05) ? 0.0 : V(HV3PENDING))
BV3PENDING HV3PENDING 0 I = -{latch_c} * (V(V3PENDINGCMD) - V(HV3PENDING)) / v3_state_tau
BHHYBRIDACTIVE HHYBRIDACTIVE 0 V = V(HV3ACTIVE)
BV3PREHOLD V3PREHOLD 0 V = (V(V3REVEDGE) > 0.05 || V(V3LATCHPULSE) > 0.05 || V(V3ACTIVATE) > 0.05 || V(HV3PENDING) > 0.05) ? 1.0 : 0.0
BV3KUPENDING V3KUPENDING 0 V = (V(V3REVEDGE) > 0.05) ? V(V3KUPRE) : V(V3KUVISSAMP)
BV3KDPENDING V3KDPENDING 0 V = (V(V3REVEDGE) > 0.05) ? V(V3KDPRE) : V(V3KDVISSAMP)
B42 KUTARGET 0 V = (V(HV3ACTIVE) > 0.05) ? V(V3KUREPLAY) : ((V(V3PREHOLD) > 0.5) ? V(V3KUPENDING) : V(KULEG))
B43 KDTARGET 0 V = (V(HV3ACTIVE) > 0.05) ? V(V3KDREPLAY) : ((V(V3PREHOLD) > 0.5) ? V(V3KDPENDING) : V(KDLEG))
B44 Ku 0 V = V(KUTARGET)
B45 Kd 0 V = V(KDTARGET)

.ENDS
